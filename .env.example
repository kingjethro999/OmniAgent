# ─── OmniAgent Engine Configuration ───

# Cloud Provider API Keys (optional — only needed for cloud routing)
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here

# Default cloud provider: "openai" | "gemini"
OMNI_CLOUD_PROVIDER=openai

# Cloud model to use for complex tasks
OMNI_CLOUD_MODEL=gpt-4o

# Local model path (Phase 2 — C++ engine)
OMNI_LOCAL_MODEL_PATH=./models/phi-4-mini.gguf

# Complexity threshold (0.0 - 1.0): tasks scoring above this go to cloud
OMNI_COMPLEXITY_THRESHOLD=0.6

# Maximum tokens for local model context window
OMNI_LOCAL_MAX_TOKENS=2048

# Dashboard Configuration
DASHBOARD_PORT=3000
DASHBOARD_WS_PORT=3001

# Agent Configuration
OMNI_MAX_STEPS=10
OMNI_VERBOSE=true
