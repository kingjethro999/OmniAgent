<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top App Bar Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_app_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_app_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_subtitle"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 0 MB Local Core Badge -->
            <LinearLayout
                android:id="@+id/layout_badge_local"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_local"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/status_local" />

                <TextView
                    android:id="@+id/tv_badge_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="0 MB Local Core"
                    android:textColor="@color/status_local"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_subtle_dark"
            android:layout_marginBottom="16dp" />

        <!-- Card 1: Assistant Accessibility Mode (Optional Feature) -->
        <LinearLayout
            android:id="@+id/card_assistant_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_cobalt"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_accessibility"
                    app:tint="@color/brand_cobalt" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/assistant_mode_title"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_assistant_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_assistant_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/assistant_mode_desc"
                android:textColor="@color/text_secondary_dark"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_accessibility_service_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/accessibility_status_inactive"
                android:textColor="@color/text_secondary_dark"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Card 2: AI Engine Backend Configuration (0 MB Engine) -->
        <LinearLayout
            android:id="@+id/card_engine_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_cobalt"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/brand_cobalt" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/backend_engine_title"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <RadioGroup
                android:id="@+id/rg_engine_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rb_mode_local"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/engine_micro_title"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/engine_micro_desc"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="11sp" />

                <RadioButton
                    android:id="@+id/rb_mode_server"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/engine_server_title"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="13sp" />
            </RadioGroup>

            <!-- Remote Server Input Box (visible when server mode selected) -->
            <LinearLayout
                android:id="@+id/layout_server_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/et_server_url"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:hint="http://192.168.1.50:8765"
                    android:textColor="@color/text_primary_dark"
                    android:textColorHint="@color/text_secondary_dark"
                    android:textSize="12sp"
                    android:inputType="textUri"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btn_save_server"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/brand_cobalt"
                    android:text="Save"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card 3: Voice Interaction & Wake Word -->
        <LinearLayout
            android:id="@+id/card_voice_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_cobalt"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="12dp">

            <!-- Wake Word Pill -->
            <TextView
                android:id="@+id/tv_wake_word_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:text="@string/wake_word_label"
                android:textColor="@color/brand_cobalt"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Circular Cobalt Voice Action Button -->
            <ImageButton
                android:id="@+id/btn_voice_listen"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_mic_button"
                android:contentDescription="Voice Assistant"
                android:src="@drawable/ic_mic"
                app:tint="#FFFFFF"
                android:scaleType="centerInside"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tv_voice_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap mic or say 'Hey Omni' to automate"
                android:textColor="@color/text_secondary_dark"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />

            <!-- Command Text Input Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/et_command_input"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/voice_prompt_hint"
                    android:textColor="@color/text_primary_dark"
                    android:textColorHint="@color/text_secondary_dark"
                    android:textSize="12sp"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btn_run_command"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/brand_cobalt"
                    android:text="@string/btn_send"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card 4: Quick Automation Triggers -->
        <LinearLayout
            android:id="@+id/card_quick_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_cobalt"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quick_actions_title"
                android:textColor="@color/text_primary_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Music Trigger -->
                    <LinearLayout
                        android:id="@+id/chip_action_music"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_play"
                            app:tint="@color/brand_cobalt" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Play The Box"
                            android:textColor="@color/text_primary_dark"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Alarm Trigger -->
                    <LinearLayout
                        android:id="@+id/chip_action_alarm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_alarm"
                            app:tint="@color/brand_cobalt" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Set Alarm 7 AM"
                            android:textColor="@color/text_primary_dark"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Call Trigger -->
                    <LinearLayout
                        android:id="@+id/chip_action_call"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_phone"
                            app:tint="@color/brand_cobalt" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Call Mum"
                            android:textColor="@color/text_primary_dark"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- WhatsApp Trigger -->
                    <LinearLayout
                        android:id="@+id/chip_action_whatsapp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_message"
                            app:tint="@color/brand_cobalt" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Open WhatsApp"
                            android:textColor="@color/text_primary_dark"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- TikTok Trigger -->
                    <LinearLayout
                        android:id="@+id/chip_action_tiktok"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_apps"
                            app:tint="@color/brand_cobalt" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Open TikTok"
                            android:textColor="@color/text_primary_dark"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Gmail Trigger -->
                    <LinearLayout
                        android:id="@+id/chip_action_gmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_message"
                            app:tint="@color/brand_cobalt" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Draft Gmail"
                            android:textColor="@color/text_primary_dark"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Card 5: Live Execution Log -->
        <LinearLayout
            android:id="@+id/card_execution_monitor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_cobalt"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/execution_monitor_title"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_monitor_status_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STANDBY"
                    android:textColor="@color/status_local"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_execution_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:padding="10dp"
                android:text="Assistant ready. Say 'Hey Omni' or select an action above."
                android:textColor="@color/text_secondary_dark"
                android:fontFamily="monospace"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
